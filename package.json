{
  "name": "readdy-3-desktop",
  "version": "1.0.0",
  "description": "Readdy 3 desktop and Android application",
  "main": "electron/main.js",
  "author": "NORRIT22",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64 --publish never",
    "android:prepare": "mkdir -p www && cp index.html landing.html french-library.html www/ && npx cap sync android",
    "android:build": "npm run android:prepare && cd android && ./gradlew assembleDebug"
  },
  "devDependencies": {
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12",
    "@capacitor/cli": "^7.4.3"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/core": "^7.4.3"
  },
  "build": {
    "appId": "com.norrit22.readdy3",
    "productName": "Readdy 3",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "index.html",
      "landing.html",
      "french-library.html",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Readdy-3-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Readdy 3"
    }
  }
}
